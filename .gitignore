# Maven build output
target/

# IDE files
.idea/
*.iml
# 本机 IDEA 运行配置（前端 npm run dev 的快捷方式）—— 属个人开发习惯，
# 和 .idea/ 一样不入库，面试官看仓库不需要它
.run/

# OS files
.DS_Store
Thumbs.db

# Environment (keep API keys out)
*.env
.env.local

# Local learning journal — 学习进度/练习记录，不随仓库发布
docs/learning-log.md

# Local credentials — 真实数据库密码等，只存本地
application-local.yml
src/main/resources/application-local.yml

# 评测用的生成数据 —— 可由 eval/gen-items.js 重新生成，不入库
eval/seed-items.sql
eval/.gen-stats.txt

# 评测脚本的临时文件
eval/.smoke-body.json
eval/.resp.json
eval/.gen-stats.txt

# 压测产物 —— .jtl 是 JMeter 原始采样日志，单轮 100MB+，
# 每次压测重新生成，且超过 GitHub 单文件 100MB 上限（推不上去）。
# 报告和压测计划才是有价值、可复现的部分，保留：
#   bench/REPORT.md（结论）、bench/plan-*.jmx（压测计划）
bench/*.jtl
bench/*.log
